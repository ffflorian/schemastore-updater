{
  "bin": "./dist/cli.js",
  "dependencies": {
    "commander": "15.0.0",
    "json-schema-to-typescript": "15.0.4",
    "semver": "7.8.5",
    "typescript": "6.0.3"
  },
  "description": "SchemaStore schema updater",
  "devDependencies": {
    "@ffflorian/oxlint-config": "1.0.3",
    "@ffflorian/prettier-config": "1.0.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@types/node": "~26",
    "@types/semver": "7.7.1",
    "eslint": "10.8.0",
    "eslint-plugin-perfectionist": "5.10.0",
    "lefthook": "2.1.10",
    "oxlint": "1.77.0",
    "prettier": "3.9.6",
    "semantic-release": "25.0.8",
    "tsx": "4.23.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "GPL-3.0",
  "name": "schemastore-updater",
  "packageManager": "yarn@4.17.1",
  "prettier": "@ffflorian/prettier-config",
  "private": true,
  "repository": "https://github.com/ffflorian/schemastore-updater",
  "scripts": {
    "bootstrap:new-packages": "tsx src/cli.ts bootstrap",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist schemas schema-lock.json .cache",
    "fix": "yarn fix:ts && yarn fix:other",
    "fix:other": "yarn prettier --write",
    "fix:ts": "yarn lint:ts --fix",
    "lint": "yarn lint:other && yarn lint:ts",
    "lint:other": "yarn prettier --list-different",
    "lint:ts": "oxlint --ignore-path .gitignore .",
    "mark-published": "tsx src/cli.ts mark-published",
    "publish:schemas": "tsx src/cli.ts publish",
    "publish:schemas:dry-run": "tsx src/cli.ts publish --dry-run",
    "prettier": "prettier \"*.{json,md,yml}\"",
    "release": "semantic-release",
    "test": "vitest run",
    "test:watch": "vitest",
    "update": "tsx src/cli.ts update"
  },
  "type": "module",
  "version": "3.0.0"
}
